{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "web-lokalny",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd web && VITE_API_URL=http://localhost:8787 npx vite --host 127.0.0.1 --port 5174"
      ],
      "port": 5174,
      "url": "http://127.0.0.1:5174"
    }
  ]
}