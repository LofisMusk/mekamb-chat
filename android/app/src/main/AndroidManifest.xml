<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Powiadomienia o nowych wiadomościach (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Usługa pierwszoplanowa utrzymująca połączenie ze skrzynką.

      Bez niej Android zabija proces po schowaniu aplikacji i przestajemy
      odbierać: wiadomość wysłana w tym czasie leżała na serwerze do następnego
      uruchomienia. Push byłby tańszy dla baterii, ale wymaga przepuszczenia
      sygnału przez serwery Google — czyli oddania im informacji o tym, ŻE
      i KIEDY ktoś do nas pisze. Treści by nie zobaczyli, metadane owszem.

      `DATA_SYNC` jest właściwym typem: utrzymujemy połączenie, którym płyną
      dane użytkownika. Od Androida 14 typ jest obowiązkowy i musi zgadzać się
      z tym podanym przy `startForeground` — rozbieżność to wyjątek zamiast
      uruchomionej usługi.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
      Baner dzwoniącej rozmowy na zablokowanym ekranie. Bez tego przychodzące
      połączenie byłoby zwykłym wierszem na liście powiadomień, czyli czymś,
      co się zauważa po fakcie.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
      Mikrofon i aparat WYŁĄCZNIE do rozmów A/V. Prosimy o nie dopiero
      w chwili dzwonienia, a nie przy starcie aplikacji: uprawnienie, którego
      użytkownik nie umie powiązać z konkretną czynnością, jest uprawnieniem
      nadanym na ślepo.

      `android:required="false"` przy sprzęcie, bo telefon bez aparatu ma
      nadal działać — rozmowa głosowa go nie potrzebuje.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Mekamb">

        <!--
          allowBackup="false" jest wymogiem bezpieczeństwa, nie preferencją:
          kopia zapasowa Androida wyniosłaby zaszyfrowany magazyn poza urządzenie,
          podczas gdy klucz, który go otwiera, zostaje w Keystore i nigdy nie
          opuszcza sprzętu. Przywrócona kopia byłaby bezużyteczna, a jednocześnie
          rozsiewałaby materiał kryptograficzny.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          `exported="false"`: usługę uruchamia wyłącznie ta aplikacja. Wystawiona
          na zewnątrz pozwalałaby dowolnej innej aplikacji ją wystartować.
        -->
        <service
            android:name=".UslugaNasluchu"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
