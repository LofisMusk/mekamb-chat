<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Powiadomienia o nowych wiadomościach (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Mikrofon i aparat WYŁĄCZNIE do rozmów A/V. Prosimy o nie dopiero
      w chwili dzwonienia, a nie przy starcie aplikacji: uprawnienie, którego
      użytkownik nie umie powiązać z konkretną czynnością, jest uprawnieniem
      nadanym na ślepo.

      `android:required="false"` przy sprzęcie, bo telefon bez aparatu ma
      nadal działać — rozmowa głosowa go nie potrzebuje.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Mekamb">

        <!--
          allowBackup="false" jest wymogiem bezpieczeństwa, nie preferencją:
          kopia zapasowa Androida wyniosłaby zaszyfrowany magazyn poza urządzenie,
          podczas gdy klucz, który go otwiera, zostaje w Keystore i nigdy nie
          opuszcza sprzętu. Przywrócona kopia byłaby bezużyteczna, a jednocześnie
          rozsiewałaby materiał kryptograficzny.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Kod przeniesienia konta. Dzięki temu wystarczy zeskanować kod QR
              APARATEM SYSTEMOWYM — Android sam otworzy tę aplikację z kodem
              w intencji. Własny skaner wymagałby uprawnienia do kamery
              i biblioteki dekodującej, czyli kilkuset kilobajtów APK za coś,
              co system już umie.

              Schemat jest własny (`mekamb://`), więc nie ma tu weryfikacji
              domeny jak przy App Links. Nie szkodzi: kod bez klucza jest
              bezużyteczny, a klucz jest w samym kodzie. Podstawiona intencja
              może najwyżej podsunąć cudzy zrzut, którego i tak nie da się
              odszyfrować.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mekamb" android:host="transfer" />
            </intent-filter>
        </activity>
    </application>
</manifest>
