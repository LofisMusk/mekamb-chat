{
  "name": "mekamb-server",
  "version": "0.1.0",
  "description": "Backend mekamb-chat na Cloudflare Workers — katalog, skrzynka offline, kolejność commitów MLS",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply mekamb --local",
    "migrate:remote": "wrangler d1 migrations apply mekamb --remote"
  },
  "dependencies": {
    "@cloudflare/opaque-ts": "^0.7.5",
    "hono": "^4.12.34",
    "otpauth": "^9.5.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.118.0"
  }
}
