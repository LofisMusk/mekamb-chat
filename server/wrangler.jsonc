{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mekamb",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    // Adresy klienta webowego: produkcyjny (GitHub Pages) i lokalne do pracy.
    // Lista, nie gwiazdka — patrz komentarz przy ALLOWED_ORIGINS w src/env.ts.
    "ALLOWED_ORIGINS": "https://lofismusk.github.io,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175",

    // `github.io` jest na publicznej liście sufiksów (PSL), więc RP ID musi
    // być pełną nazwą hosta — samego `github.io` przeglądarka by odrzuciła.
    "WEBAUTHN_RP_ID": "lofismusk.github.io",
    "WEBAUTHN_RP_NAME": "mekamb-chat"
  },

  "observability": {
    // Logi przydają się przy diagnozowaniu, ale nie mogą zawierać treści.
    // Serwer i tak jej nie widzi — patrz docs/THREAT_MODEL.md.
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mekamb",
      "database_id": "2d53084c-3b63-4f22-8ab4-d7dc6c5bdd57",
      "migrations_dir": "migrations"
    }
  ],

  // Zaszyfrowane załączniki. Serwer przechowuje wyłącznie szyfrogram — klucz
  // podróżuje w kanale MLS i nigdy nie przechodzi przez ten kubełek.
  //
  // Binding pozostaje w kodzie opcjonalny: wdrożenie na koncie bez włączonego
  // R2 jest poprawnym stanem, a endpointy zwracają wtedy czytelne 503.
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "mekamb-attachments"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "USER_INBOX", "class_name": "UserInbox" },
      { "name": "GROUP_RELAY", "class_name": "GroupRelay" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      // SQLite-owe Durable Objects są warunkiem korzystania z darmowego tieru.
      "new_sqlite_classes": ["UserInbox", "GroupRelay", "RateLimiter"]
    }
  ],

  "triggers": {
    // Sprzątanie wygasłych kopert i osieroconych załączników.
    "crons": ["0 4 * * *"]
  },

  // Środowisko testowe. Wdrażane osobno: `wrangler deploy --env dev` stawia
  // Workera `mekamb-dev` z WŁASNĄ bazą D1 i własnymi Durable Objects, więc konta
  // testowe nie mieszają się z produkcyjnymi. `TRYB_DEWELOPERSKI=true` odblokowuje
  // obejścia z src/dev.ts (pominięcie 2FA, brak limitów prób, aktywacja kont od
  // razu, endpoint /dev/seed). Produkcja tego bloku nie używa — jej flaga pozostaje
  // nieustawiona, więc te furtki są tam martwe.
  //
  // Zanim zadziała, jednorazowo:
  //   wrangler d1 create mekamb-dev              # i wklej zwrócone id poniżej
  //   wrangler d1 migrations apply mekamb-dev --remote --env dev
  //   wrangler secret put OPAQUE_SERVER_KEY   --env dev
  //   wrangler secret put TOKEN_SIGNING_KEY   --env dev
  //   wrangler secret put TOTP_ENCRYPTION_KEY --env dev
  // Lokalnie (`wrangler dev --env dev`) sekrety idą do pliku `.dev.vars`.
  "env": {
    "dev": {
      "vars": {
        "TRYB_DEWELOPERSKI": "true",
        "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175",
        "WEBAUTHN_RP_ID": "localhost",
        "WEBAUTHN_RP_NAME": "mekamb-chat (dev)"
      },

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mekamb-dev",
          // PLACEHOLDER — wynik `wrangler d1 create mekamb-dev`.
          "database_id": "URUCHOM-wrangler-d1-create-mekamb-dev-I-WKLEJ-ID",
          "migrations_dir": "migrations"
        }
      ],

      // Bindingi nie dziedziczą się do środowiska nazwanego — trzeba je powtórzyć.
      // Klasy te same co produkcyjne, ale namespace DO jest per-Worker, więc
      // `mekamb-dev` i tak dostaje własne, odrębne instancje.
      "durable_objects": {
        "bindings": [
          { "name": "USER_INBOX", "class_name": "UserInbox" },
          { "name": "GROUP_RELAY", "class_name": "GroupRelay" },
          { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
        ]
      },

      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["UserInbox", "GroupRelay", "RateLimiter"]
        }
      ]
    }
  }
}
